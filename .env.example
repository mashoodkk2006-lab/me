# ==============================================================================
# THE AURORA PROTOCOL — ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port (Render automatically sets this, defaults to 3000 locally)
PORT=3000

# TiDB Cloud / MySQL Connection Details
# Replace with your actual credentials from TiDB Cloud Console (https://tidbcloud.com)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username.root
DB_PASSWORD=your_tidb_password
DB_NAME=aurora_protocol

# Alternative: Single Connection URL (if provided by your database host)
# MYSQL_URL=mysql://user:pass@host:4000/aurora_protocol?ssl={"rejectUnauthorized":false}

# JWT Secret for Session & Authorization tokens (use a long random secret in production)
JWT_SECRET=aurora_protocol_super_secure_jwt_token_2026_investigation

# Node Environment
NODE_ENV=production
